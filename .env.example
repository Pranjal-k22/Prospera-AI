# ==============================================================================
# PROSPERA AI - ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env.local and fill in your credentials.
# ==============================================================================

# 1. Google Gemini AI API Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="" # e.g. gemini-2.0-flash, gemini-1.5-flash-8b (must support generateContent)

# 2. Database Connection (MongoDB)
MONGODB_URI=""

# 3. Authentication & Security
JWT_SECRET=""

# 4. App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
